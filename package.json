{
  "name": "number-go-up",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Number Go Up — a minimalist roguelike deck-building game where you build an arithmetic syntax tree to make the number go up.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
